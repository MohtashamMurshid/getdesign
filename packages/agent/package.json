{
  "name": "@getdesign/agent",
  "version": "0.1.0",
  "description": "Agent runtime for turning live websites into structured design systems and design.md specs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 10000",
    "smoke": "bun run smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@getdesign/tools": "workspace:*",
    "@getdesign/types": "workspace:*",
    "ai": "^6.0.174",
    "zod": "^4.4.2"
  }
}
