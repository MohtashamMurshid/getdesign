{
  "name": "@getdesign/cli",
  "version": "0.0.1",
  "description": "Generate a design.md from any public URL.",
  "keywords": [
    "design-system",
    "design.md",
    "design-tokens",
    "css",
    "scraper",
    "cli",
    "agent",
    "getdesign"
  ],
  "homepage": "https://getdesign.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohtashamMurshid/getdesign.git"
  },
  "bugs": {
    "url": "https://github.com/MohtashamMurshid/getdesign/issues"
  },
  "license": "MIT",
  "author": "getdesign",
  "type": "module",
  "bin": {
    "getdesign": "./src/getdesign.ts"
  },
  "main": "./src/getdesign.ts",
  "scripts": {
    "smoke": "bun ./src/getdesign.ts --help",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@getdesign/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
