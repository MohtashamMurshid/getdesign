{
  "name": "@getdesign/cli",
  "version": "0.0.1",
  "description": "Generate a design.md from any public URL.",
  "keywords": [
    "design-system",
    "design.md",
    "design-tokens",
    "css",
    "scraper",
    "cli",
    "agent",
    "getdesign"
  ],
  "homepage": "https://getdesign.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohtashamMurshid/getdesign.git"
  },
  "bugs": {
    "url": "https://github.com/MohtashamMurshid/getdesign/issues"
  },
  "license": "MIT",
  "author": "getdesign",
  "type": "module",
  "bin": {
    "getdesign": "./dist/getdesign.js"
  },
  "main": "./dist/getdesign.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "bun ./src/getdesign.ts --help",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@getdesign/sdk": "workspace:*",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
