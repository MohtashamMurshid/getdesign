{
  "name": "@getdesign/sdk",
  "version": "0.0.1",
  "description": "Remote-first TypeScript SDK for generating design.md from any public URL.",
  "keywords": [
    "design-system",
    "design.md",
    "design-tokens",
    "css",
    "scraper",
    "sdk",
    "typescript",
    "agent",
    "getdesign"
  ],
  "homepage": "https://getdesign.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohtashamMurshid/getdesign.git"
  },
  "bugs": {
    "url": "https://github.com/MohtashamMurshid/getdesign/issues"
  },
  "license": "MIT",
  "author": "getdesign",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@getdesign/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
